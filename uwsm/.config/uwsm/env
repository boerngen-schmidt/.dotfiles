# Changes require a restart to take effect.

# Ensure Omarchy bins are in the path
export HELPERS_PATH=$HOME/.local/share/desktop
export PATH=$HELPERS_PATH/bin:$PATH

# Personal scripts, e.g. the desktop-network package's helpers
export PATH=$HOME/.local/bin:$PATH

# Where the shell, themes and their scripts live (Omarchy's OMARCHY_PATH)
export DESKTOP_SHELL_PATH=$HELPERS_PATH

# Set default terminal and editor
source ~/.config/uwsm/default
