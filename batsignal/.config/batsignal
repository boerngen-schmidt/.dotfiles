# batsignal options, one argument per line (see man batsignal).
# Levels must be strictly descending: warning > critical > danger.
# UPower hibernates at 3% (benstop playbooks/system/powermanagement.yml).

# Warning popup
-w
20
-W
Battery low, plug in soon

# Critical popup
-c
15
-C
Battery critical, plug in now

# Danger: dim the screen and switch to power-saver.
# TLP switches back to balanced when the charger is connected.
-d
10
-D
notify-send -a batsignal -u critical "Battery at 10%" "Screen dimmed, power-saver enabled"; brightnessctl -q set 30%; tlpctl power-saver
