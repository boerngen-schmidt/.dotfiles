#!/bin/bash

# omarchy:summary=Run the power profiles client, powerprofilesctl or TLP's tlpctl
# omarchy:args=[list|get|set <profile>]
# omarchy:hidden=true

# tlp-pd serves the same D-Bus API as power-profiles-daemon but ships tlpctl
# instead of powerprofilesctl. Its list output matches, so callers parse either.
if command -v powerprofilesctl >/dev/null 2>&1; then
  exec powerprofilesctl "$@"
elif command -v tlpctl >/dev/null 2>&1; then
  exec tlpctl "$@"
fi

echo "No power profiles client found (powerprofilesctl or tlpctl)" >&2
exit 1
