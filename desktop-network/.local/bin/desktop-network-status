#!/bin/bash

# Print the active network status for the desktop shell, without
# NetworkManager: the route and counters come from ip and /sys, Wi-Fi details
# from iw. Output matches Omarchy's omarchy-network-status so the bar, the
# speed test and the network panel can read it unchanged.
#
#   desktop-network-status            kind<TAB>label<TAB>signal<TAB>freq
#   desktop-network-status --verbose  key<TAB>value lines for the network panel
#   desktop-network-status --dns      the DNS provider (DHCP, Cloudflare, Google, Custom)
#   desktop-network-status --band     band, available and selected lines for the panel

internet_probe=1.1.1.1
dns_helper=/usr/local/bin/desktop-network-dns
band_helper=/usr/local/bin/desktop-network-band

mode=${1:-}
case "$mode" in
  "" | --verbose | --dns | --band) ;;
  *)
    echo "Usage: desktop-network-status [--verbose|--dns|--band]" >&2
    exit 2
    ;;
esac

route_device() {
  ip route get "$internet_probe" 2>/dev/null | awk '{ for (i = 1; i <= NF; i++) if ($i == "dev") { print $(i + 1); exit } }'
}

# iw escapes non-printable SSID bytes as \xNN; %b turns them back.
decode_ssid() {
  printf '%b' "$1"
}

# iw reports signal in dBm; scale it to the 0-100 NetworkManager reports.
signal_percent() {
  local dbm=${1%%.*}
  [[ $dbm =~ ^-?[0-9]+$ ]] || return
  local percent=$(((dbm + 100) * 2))
  ((percent < 0)) && percent=0
  ((percent > 100)) && percent=100
  echo "$percent"
}

band_for_freq() {
  local mhz=${1%%[!0-9]*}
  [[ -n $mhz ]] || return 1
  if ((mhz >= 2400 && mhz < 2500)); then
    echo "2.4"
  elif ((mhz >= 4900 && mhz < 5925)); then
    echo "5"
  elif ((mhz >= 5925 && mhz < 7125)); then
    echo "6"
  else
    return 1
  fi
}

print_status() {
  local device link ssid signal freq

  device=$(route_device)

  if [[ -z $device ]]; then
    printf 'disconnected\t\t\t\n'
    return
  fi

  if [[ ! -d /sys/class/net/$device/wireless ]]; then
    printf 'ethernet\t%s\t\t\n' "$device"
    return
  fi

  link=$(iw dev "$device" link 2>/dev/null)
  if [[ -z $link || $link == Not\ connected* ]]; then
    printf 'disconnected\t\t\t\n'
    return
  fi

  ssid=$(decode_ssid "$(awk '/SSID:/ { sub(/.*SSID: /, ""); print; exit }' <<<"$link")")
  signal=$(signal_percent "$(awk '/signal:/ { print $2; exit }' <<<"$link")")
  freq=$(awk '/freq:/ { print $2; exit }' <<<"$link")

  printf 'wifi\t%s\t%s\t%s\n' "${ssid:-$device}" "$signal" "$freq"
}

ping_latency_ms() {
  local host=$1

  LC_ALL=C ping -n -c 1 -W 1 "$host" 2>/dev/null | awk -F'time[=<]' '/time[=<]/ { split($2, parts, " "); print parts[1]; exit }'
}

print_ping_samples() {
  local gateway=$1
  local tmpdir router_file internet_file
  local router_pid="" internet_pid=""

  command -v ping >/dev/null || return
  tmpdir=$(mktemp -d) || return
  router_file="$tmpdir/router"
  internet_file="$tmpdir/internet"

  if [[ -n $gateway ]]; then
    ping_latency_ms "$gateway" >"$router_file" &
    router_pid=$!
  fi

  ping_latency_ms "$internet_probe" >"$internet_file" &
  internet_pid=$!

  if [[ -n $router_pid ]]; then
    wait "$router_pid"
    printf 'router_ping_ms\t%s\n' "$(cat "$router_file")"
  fi

  wait "$internet_pid"
  printf 'internet_ping_ms\t%s\n' "$(cat "$internet_file")"
  rm -rf "$tmpdir"
}

print_verbose() {
  local route_json iface gw src prefix link

  route_json=$(ip -j route get "$internet_probe" 2>/dev/null)
  [[ -z $route_json ]] && return

  iface=$(jq -r '.[0].dev // ""' <<<"$route_json" 2>/dev/null)
  gw=$(jq -r '.[0].gateway // ""' <<<"$route_json" 2>/dev/null)
  src=$(jq -r '.[0].prefsrc // ""' <<<"$route_json" 2>/dev/null)

  [[ -z $iface ]] && return

  prefix=$(ip -j addr show "$iface" 2>/dev/null | jq -r '.[0].addr_info[]? | select(.family == "inet") | .prefixlen // ""' 2>/dev/null | head -n 1)

  printf 'iface\t%s\n' "$iface"
  printf 'ip\t%s\n' "$src"
  printf 'prefix\t%s\n' "$prefix"
  printf 'gateway\t%s\n' "$gw"

  if [[ -r /sys/class/net/$iface/statistics/rx_bytes ]]; then
    printf 'rx_bytes\t%s\n' "$(cat "/sys/class/net/$iface/statistics/rx_bytes")"
  fi
  if [[ -r /sys/class/net/$iface/statistics/tx_bytes ]]; then
    printf 'tx_bytes\t%s\n' "$(cat "/sys/class/net/$iface/statistics/tx_bytes")"
  fi

  if [[ -d /sys/class/net/$iface/wireless ]]; then
    printf 'type\twifi\n'

    link=$(iw dev "$iface" link 2>/dev/null)
    if [[ -n $link && $link != Not\ connected* ]]; then
      # The panel decodes iw's \xNN escapes itself, so the SSID stays raw here.
      printf 'ssid\t%s\n' "$(awk '/SSID:/ { sub(/.*SSID: /, ""); print; exit }' <<<"$link")"
      printf 'signal_dbm\t%s\n' "$(awk '/signal:/ { print $2; exit }' <<<"$link")"
      printf 'freq\t%s\n' "$(awk '/freq:/ { print $2; exit }' <<<"$link")"
      printf 'bitrate\t%s %s\n' "$(awk '/tx bitrate:/ { print $3; exit }' <<<"$link")" "$(awk '/tx bitrate:/ { print $4; exit }' <<<"$link")"
    fi
  else
    printf 'type\tethernet\n'
    [[ -r /sys/class/net/$iface/speed ]] && printf 'speed\t%s\n' "$(cat "/sys/class/net/$iface/speed" 2>/dev/null)"
    [[ -r /sys/class/net/$iface/duplex ]] && printf 'duplex\t%s\n' "$(cat "/sys/class/net/$iface/duplex" 2>/dev/null)"
  fi

  print_ping_samples "$gw"
}

print_dns() {
  [[ -x $dns_helper ]] || exit 1
  "$dns_helper" status 2>/dev/null | jq -er '.provider'
}

# iwd's band preference is global (its [Rank] settings), so the choices are
# the bands the radio supports, not the bands one network answers on.
supported_bands() {
  iw phy 2>/dev/null | awk '
    /^[[:space:]]+\* [0-9.]+ MHz/ && !/disabled/ {
      mhz = $2 + 0
      if (mhz >= 2400 && mhz < 2500) seen["2.4"] = 1
      else if (mhz >= 4900 && mhz < 5925) seen["5"] = 1
      else if (mhz >= 5925 && mhz < 7125) seen["6"] = 1
    }
    END {
      out = ""
      if (seen["2.4"]) out = out " 2.4"
      if (seen["5"]) out = out " 5"
      if (seen["6"]) out = out " 6"
      sub(/^ /, "", out)
      print out
    }'
}

print_band() {
  local device freq band="" selected=auto

  device=$(route_device)
  if [[ -n $device && -d /sys/class/net/$device/wireless ]]; then
    freq=$(iw dev "$device" link 2>/dev/null | awk '/freq:/ { print $2; exit }')
    band=$(band_for_freq "$freq" || true)
  fi

  if [[ -x $band_helper ]]; then
    selected=$("$band_helper" status 2>/dev/null | jq -r '.selected // "auto"')
  fi

  printf 'band\t%s\n' "$band"
  printf 'available\t%s\n' "$(supported_bands)"
  printf 'selected\t%s\n' "${selected:-auto}"
}

case "$mode" in
  --verbose) print_verbose ;;
  --dns) print_dns ;;
  --band) print_band ;;
  *) print_status ;;
esac
