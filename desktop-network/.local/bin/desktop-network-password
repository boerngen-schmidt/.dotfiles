#!/bin/bash

# Print the connected Wi-Fi network's passphrase for the shell's share card,
# read from iwd's saved network file through the root helper
# desktop-network-psk. Mirrors Omarchy's omarchy-network-password.
#
#   desktop-network-password <interface>

set -euo pipefail

psk_helper=/usr/local/bin/desktop-network-psk

interface=${1:?Usage: desktop-network-password <interface>}

if ! current=$(desktop-network-iwd current "$interface" 2>/dev/null); then
  echo "No active Wi-Fi connection" >&2
  exit 1
fi

ssid=$(jq -r '.ssid' <<<"$current")
case "$(jq -r '.security' <<<"$current")" in
  8021x)
    echo "Enterprise Wi-Fi has no shareable password" >&2
    exit 1
    ;;
  psk) ;;
  *)
    echo "This network has no password" >&2
    exit 1
    ;;
esac

status=0
password=$(sudo -n "$psk_helper" "$ssid" 2>/dev/null) || status=$?
if ((status == 2)); then
  echo "This network has no saved passphrase" >&2
  exit 1
elif ((status != 0)) || [[ -z $password ]]; then
  echo "Could not read the Wi-Fi password" >&2
  exit 1
fi

# Stdout is a private pipe to the caller; the secret is never an argument.
printf '%s\n' "$password"
